#!/bin/sh
# systemd runs this at the very end of shutdown (from /run/initramfs), after
# stopping everything. The Lights Out system is mounted at /oldroot, and its
# file lives on the Windows drive mounted inside it, so close in this order:
# your space (if still open), Windows drive (lazy), system file, loop devices, then
# the BitLocker unlock. Each step is added to the restart record on the EFI partition
# (restart.log, started by lightsout-closing; Windows copies it to C:\LightsOut\logs\boot),
# so a restart that stops tells where.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
umount -l /oldroot/boot/efi 2>/dev/null
mkdir -p /esp && mount -t vfat "$(cat /esp-dev)" /esp 2>/dev/null
R=/esp/EFI/lightsout/results/restart.log
step() { echo "$(cut -d' ' -f1 /proc/uptime) $*" >> "$R" 2>/dev/null; sync; }
step "closing, then: ${1:-reboot}"
umount /oldroot/home/lights 2>/dev/null
umount -l /oldroot/mnt/c 2>/dev/null
umount /oldroot 2>/dev/null || umount -l /oldroot
step "your space and the system file closed"
for l in /dev/loop*; do losetup -d "$l" 2>/dev/null; done
sleep 1
step "loop devices let go"
# udev is gone by now, but its mark in /run is not: without DM_DISABLE_UDEV the device-mapper
# library waits for udev's answer forever (a restart that hangs); and never more than 10 s
DM_DISABLE_UDEV=1 timeout 10 cryptsetup close winc 2>/dev/null
step "drive locked again ($?)"
dmesg | tail -n 10 | sed "s/^/  kernel: /" >> "$R" 2>/dev/null   # what the kernel said while closing
# The drives' own caches written out (an fsync of each disk, nothing written), so that even a
# reset from here on loses nothing
for d in /dev/nvme[0-9]n[0-9] /dev/sd[a-z] /dev/vd[a-z]; do
  [ -b "$d" ] && dd if=/dev/zero of="$d" bs=512 count=0 conv=notrunc,fsync 2>/dev/null
done
case "$1" in
  poweroff|halt)
    step "now: $1 (anything after this is the kernel and the PC's firmware)"
    umount /esp 2>/dev/null; sync
    poweroff -f ;;
  *)
    # Everything is closed and written out: restart at once, as the reset button does. (The
    # kernel's own restart first wakes and stops every device one by one, and on some PCs one
    # of them holds it up until the watchdog resets the PC, 30 s later.)
    step "now: restart"
    umount /esp 2>/dev/null; sync
    echo 1 > /proc/sys/kernel/sysrq 2>/dev/null
    echo b > /proc/sysrq-trigger
    reboot -f ;;
esac
