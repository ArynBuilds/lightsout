[Unit]
Description=Lights Out: a restart or shut-down is recorded, and PCIe links leave power saving for it
# stopped first at a restart (after the screen's target), while the EFI partition is still open
After=graphical.target
RequiresMountsFor=/boot/efi

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/sbin/lightsout-closing

[Install]
WantedBy=graphical.target
