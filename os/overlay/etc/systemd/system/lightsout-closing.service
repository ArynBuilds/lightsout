[Unit]
Description=Lights Out: a restart or shut-down starts its record
# started with the terminal, so it is stopped before it at any restart, even one right after
# the start (the screen's whole target is reached only later); the EFI partition is still open
After=lightsout-session.service
RequiresMountsFor=/boot/efi

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/sbin/lightsout-closing

[Install]
WantedBy=graphical.target
