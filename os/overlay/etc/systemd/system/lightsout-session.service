[Unit]
Description=Lights Out: the full-screen terminal
After=systemd-user-sessions.service lightsout-wifi.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
User=lights
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=journal
UtmpIdentifier=tty1
UtmpMode=user
WorkingDirectory=~
Environment=XDG_SESSION_TYPE=wayland
# Software rendering would cost CPU; let Mesa use the integrated GPU, idle when nothing changes
ExecStart=/usr/local/lib/lightsout/start-terminal.sh
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
