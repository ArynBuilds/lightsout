[Unit]
Description=Lights Out: power settings (put back when it stops: at a restart or shut-down)
After=systemd-modules-load.service iwd.service
# (stopped while the EFI partition is still open: the restart record is there)
RequiresMountsFor=/boot/efi

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lightsout-power
# again once Wi-Fi and late devices are up
ExecStartPost=/bin/sh -c 'sleep 20; /usr/local/sbin/lightsout-power'
RemainAfterExit=yes
ExecStop=/usr/local/sbin/lightsout-power --restore

[Install]
WantedBy=multi-user.target
