[Unit]
Description=Lights Out self-test (only when the build test asks for it)
ConditionPathExists=/boot/efi/EFI/lightsout/selftest
After=lightsout-session.service lightsout-wifi.service

[Service]
# simple: start-up counts as finished without it, so it can wait for that
Type=simple
ExecStart=/usr/local/lib/lightsout/selftest.sh

[Install]
WantedBy=graphical.target
