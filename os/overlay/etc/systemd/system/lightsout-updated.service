[Unit]
Description=Lights Out: the update started fine, so the previous version is removed
After=lightsout-session.service
ConditionPathExists=/mnt/c/LightsOut/update/trial

[Service]
Type=oneshot
# the terminal has been running for a while: keep this version (else Windows puts the
# previous one back at its next start, see cleanup.ps1)
ExecStart=/bin/sh -c 'sleep 15; pgrep -x lightsout-app >/dev/null && rm -rf /mnt/c/LightsOut/update/trial /mnt/c/LightsOut/update/tried /mnt/c/LightsOut/update/previous'

[Install]
WantedBy=graphical.target
