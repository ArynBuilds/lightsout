#!/bin/sh
# systemd runs this once every program has stopped and it has closed what it can, right before
# the last steps (lo-shutdown): marks that point in the restart record, with the kernel's last
# messages (what systemd couldn't close shows there).
mkdir -p /run/lo-esp && mount -t vfat "$(cat /run/initramfs/esp-dev)" /run/lo-esp 2>/dev/null || exit 0
R=/run/lo-esp/EFI/lightsout/results/restart.log
echo "$(cut -d' ' -f1 /proc/uptime) programs stopped, systemd closed what it could" >> "$R"
dmesg | tail -n 15 | sed 's/^/  kernel: /' >> "$R"
umount /run/lo-esp; sync
