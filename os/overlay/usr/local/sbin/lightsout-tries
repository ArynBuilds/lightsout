#!/bin/sh
# Kernel options Lights Out tries once on this PC and keeps only if the start comes up.
# The record is on the EFI partition (EFI\lightsout\tries, kept by updates), one line each:
# "<option> try|trying|on|off". The starter turns try into trying when a start uses it,
# and trying into off (and takes it off the boot line) when that start never came up.
#   lightsout-tries          at start: what this PC seems to need, on the boot line from the next start
#   lightsout-tries started  this start came up: what it tried is kept (on)
E=/boot/efi/EFI; T=$E/lightsout/tries
[ -d "$E/lightsout" ] || exit 0    # Lights Out mode only
case "${1:-}" in
  started) [ -f "$T" ] && sed -i 's/ trying$/ on/' "$T" ;;
  *)
    want() {   # $1 = kernel option, $2 = why (from this start's kernel messages)
      grep -q "^$1 " "$T" 2>/dev/null && return   # being tried, or decided already
      echo "$1 try" >> "$T"
      echo "lightsout-tries: trying $1 from the next start: $2" > /dev/kmsg
    }
    # Windows' own drivers save PCIe link power; Linux may only when the BIOS lets it
    dmesg | grep -q 'FADT indicates ASPM is unsupported' && want pcie_aspm=force "the BIOS keeps PCIe link power saving from Linux"
    # what is tried or kept stays on the boot line (an update brings a fresh one); the
    # Fedora folder's copy only when Lights Out made that folder
    for g in "$E/lightsout/grub.cfg" "$E/fedora/grub.cfg"; do
      [ "$g" = "$E/fedora/grub.cfg" ] && [ ! -f "$E/lightsout/created-fedora-dir" ] && continue
      grep -E ' (try|trying|on)$' "$T" 2>/dev/null | while read -r opt _; do
        case " $(grep '^linux ' "$g") " in
          *" $opt "*) ;;
          *) sed -i "s|^\(linux /EFI/lightsout/vmlinuz .*\)\$|\1 $opt|" "$g" ;;
        esac
      done
    done ;;
esac
exit 0
