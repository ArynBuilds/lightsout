#!/bin/sh
# Once the terminal has run for a while, this start counts as good: an update keeps its
# new version (else Windows puts the previous one back, see cleanup.ps1), and a kernel
# option this start tried stays on (EFI\lightsout\tries; the installer adds, the starter
# marks and takes back).
sleep 15
pgrep -x lightsout-app >/dev/null || exit 0
rm -rf /mnt/c/LightsOut/update/trial /mnt/c/LightsOut/update/tried /mnt/c/LightsOut/update/previous
sed -i 's/ trying$/ on/' /boot/efi/EFI/lightsout/tries 2>/dev/null
exit 0
