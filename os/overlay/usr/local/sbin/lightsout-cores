#!/bin/sh
# Adaptive cores: agents start on the 1-2 most frugal cores. When work is
# waiting for a core (the kernel's CPU pressure), more cores are added; after a
# calm minute it steps back down. Work finishes fast, then the chip sleeps deeply.
#   step 0: frugal cores   step 1: all but the fastest cores   step 2: all cores
F=/run/lightsout/cores.frugal
units="user.slice lightsout.slice lightsout-session.service"
total=$(nproc --all)
all="0-$((total - 1))"
top=$(cat /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq 2>/dev/null | sort -n | tail -1)
mid=""
for c in /sys/devices/system/cpu/cpu[0-9]*; do
  f=$(cat "$c/cpufreq/cpuinfo_max_freq" 2>/dev/null)
  [ -n "$f" ] && [ "$f" != "$top" ] && mid="$mid${mid:+,}${c##*cpu}"
done
# This runs every 5 s, so it uses the shell's own commands only: each program started would
# wake the processor (only `sleep` is started).
count() {  # cores in a list like "0-3,8,10-11" -> $n
  n=0; rest="$1,"
  while [ -n "$rest" ]; do
    part=${rest%%,*}; rest=${rest#*,}
    case $part in
      *-*) n=$((n + ${part#*-} - ${part%-*} + 1)) ;;
      ?*) n=$((n + 1)) ;;
    esac
  done
}
pressure() {  # $p = % of the last 10 s that work was waiting for a core ($1 = the cores in use)
  if read -r _ p _ 2>/dev/null < /proc/pressure/cpu; then
    p=${p#avg10=}; p=${p%%.*}
  else  # older kernels: load compared to the cores in use
    count "$1"; read -r l _ < /proc/loadavg; l=${l%%.*}
    p=$((l * 100 / (n > 0 ? n : 1) - 100))
  fi
}
step=0; calm=0
while sleep 5; do
  read -r frugal 2>/dev/null < "$F" || continue
  case $step in 0) cur=$frugal ;; 1) cur=${mid:-$all} ;; *) cur=$all ;; esac
  pressure "$cur"
  if [ "$p" -ge 20 ] && [ $step -lt 2 ]; then
    step=$((step + 1)); calm=0
  elif [ "$p" -lt 5 ] && [ $step -gt 0 ]; then
    calm=$((calm + 1)); [ $calm -ge 12 ] && { step=$((step - 1)); calm=0; }
  else
    calm=0; continue
  fi
  case $step in 0) set_cores "$frugal" ;; 1) set_cores "${mid:-$all}" ;; *) set_cores "$all" ;; esac
done
