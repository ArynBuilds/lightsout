#!/bin/sh
# Power settings for agent work. Every knob is optional: whatever this machine
# lacks is skipped, so the same script runs on any PC.
# `lightsout-power --restore` puts every changed value back: on a Linux PC when the desktop
# returns, and at every restart or shut-down of Lights Out (the service stops), so the
# devices are awake and as the PC set them (a graphics card fully off, or a link in its
# deepest saving, can hang the restart while the kernel stops the devices).
SAVED=/run/lightsout/power.saved
if [ "${1:-}" = --restore ]; then
  [ -f "$SAVED" ] && while read -r f v; do [ -w "$f" ] && echo "$v" > "$f" 2>/dev/null; done < "$SAVED"
  rm -f "$SAVED"
  for u in user.slice lightsout.slice lightsout-session.service; do
    systemctl set-property --runtime "$u" AllowedCPUs= 2>/dev/null
  done
  # Lights Out on a Windows PC: in the restart record (see lightsout-closing)
  R=/boot/efi/EFI/lightsout/results/restart.log
  [ -f "$R" ] && echo "$(cut -d' ' -f1 /proc/uptime) power settings put back: every device awake" >> "$R"
  exit 0
fi
mkdir -p /run/lightsout
w() {
  [ -w "$2" ] || return 0
  grep -qF "$2 " "$SAVED" 2>/dev/null || printf '%s %s\n' "$2" "$(head -n1 "$2" 2>/dev/null)" >> "$SAVED"
  echo "$1" > "$2" 2>/dev/null
  return 0
}

for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do w powersave "$f"; done
for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do w power "$f"; done
w 1 /sys/devices/system/cpu/intel_pstate/no_turbo
w 0 /sys/devices/system/cpu/cpufreq/boost
pp=/sys/firmware/acpi/platform_profile
for c in low-power quiet cool; do grep -qw "$c" "${pp}_choices" 2>/dev/null && { w "$c" "$pp"; break; }; done

# Runtime power management everywhere (idle chips switch off on their own)
for f in /sys/bus/pci/devices/*/power/control; do w auto "$f"; done
for d in /sys/bus/usb/devices/*; do
  grep -qs '^03$' "$d"/*/bInterfaceClass && continue   # keyboards/touchpads stay awake
  w auto "$d/power/control"
done
for f in /sys/class/scsi_host/host*/link_power_management_policy; do w med_power_with_dipm "$f"; done
w 1 /sys/module/snd_hda_intel/parameters/power_save

w 0 /proc/sys/kernel/nmi_watchdog
w 1500 /proc/sys/vm/dirty_writeback_centisecs
w 1 /proc/sys/vm/laptop_mode

for f in /sys/class/rfkill/rfkill*; do [ "$(cat "$f/type" 2>/dev/null)" = bluetooth ] && w 1 "$f/soft"; done
for f in /sys/class/leds/*kbd_backlight*/brightness; do w 0 "$f"; done
iw dev 2>/dev/null | awk '/Interface/{print $2}' | while read -r i; do iw dev "$i" set power_save on 2>/dev/null; done
# Separate graphics card (not the one driving the screen): let it power off.
for d in /sys/bus/pci/devices/*; do
  case "$(cat "$d/class" 2>/dev/null)" in 0x03*) ;; *) continue ;; esac
  [ "$(cat "$d/boot_vga" 2>/dev/null)" = 1 ] && continue
  w auto "$d/power/control"
done

# Work starts on the most frugal cores (lowest top speed, e.g. low-power E-cores;
# identical cores: the first two). lightsout-cores adds more cores only while
# work is waiting and goes back when it's calm, so no fixed watt limit is needed.
min=$(cat /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq 2>/dev/null | sort -n | head -1)
cores=""
if [ -n "$min" ]; then
  for c in /sys/devices/system/cpu/cpu[0-9]*; do
    [ "$(cat "$c/cpufreq/cpuinfo_max_freq" 2>/dev/null)" = "$min" ] && cores="$cores${cores:+,}${c##*cpu}"
  done
fi
n=$(echo "$cores" | tr ',' ' ' | wc -w)
total=$(nproc --all)
{ [ -z "$cores" ] || [ "$n" -ge "$total" ]; } && cores="0-$(( total > 1 ? 1 : 0 ))"
echo "$cores" > /run/lightsout/cores.frugal
# once lightsout-cores runs it decides the cores (this script runs again 20 s after the start)
systemctl is-active -q lightsout-cores || for u in user.slice lightsout.slice lightsout-session.service; do
  systemctl set-property --runtime "$u" AllowedCPUs="$cores" 2>/dev/null
done
echo "lightsout-power: work cores $cores" > /dev/kmsg 2>/dev/null
exit 0
