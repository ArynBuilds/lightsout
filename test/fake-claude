#!/bin/sh
# A stand-in for Claude Code in the tests: says how it was started and, like the real one,
# records its conversation in ~/.claude/sessions/<pid>.json while it runs and removes the
# record when it stops. "claude NAME" starts conversation NAME, "claude --resume NAME" continues it.
echo "fake-claude $*"
id=$1
[ "$1" = --resume ] && id=$2
mkdir -p ~/.claude/sessions
echo "{\"sessionId\":\"$id\"}" > ~/.claude/sessions/$$.json
trap 'rm -f ~/.claude/sessions/$$.json; exit 0' TERM HUP INT
while :; do sleep 1; done
