[Unit]
Description=Lights Out: low-power settings (put back when the desktop returns)
# put back before systemd saves Bluetooth's state at a shutdown
After=systemd-rfkill.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/lightsout-power
ExecStop=/usr/local/sbin/lightsout-power --restore
