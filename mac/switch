#!/bin/sh
# Lights Out on a Mac (runs as root through sudo, allowed for the installing user).
#   out PID [stay]  Lights Out: Low Power Mode, never sleep (lid closed keeps
#          running), Spotlight indexing, Time Machine and Bluetooth off. Then,
#          once the app (PID) has closed, the background service takes over the
#          agents and you're logged out, so almost nothing else runs.
#          Stays signed in instead ("stay", no service installed, or local
#          servers running that a log-out would end): nothing is stopped; every
#          other process runs at the lowest priority (servers and Lights Out excepted).
#   in     Lights On: everything put back exactly as it was
#   awake  the app is open: closing the lid doesn't stop it
#   sleep  the app closed: your sleep setting is back
S="/Library/Application Support/LightsOut"
AGENTS=/Library/LaunchDaemons/sh.lightsout.agents.plist
mkdir -p "$S"
pm() { pmset -g | awk -v k="$1" '$1==k {print $2}'; }
remember() { [ -f "$S/$1" ] || printf '%s' "$2" > "$S/$1"; }
bt() { command -v blueutil >/dev/null && blueutil "$@"; }
ME="${SUDO_USER:-$(stat -f %Su /dev/console)}"
UID_ME=$(id -u "$ME")
# Lights Out and every process it started (agents, their tools)
tree() {
  ps -axo pid=,ppid= | awk -v root="$1" '
    { kids[$2] = kids[$2] " " $1 }
    END { n = split(root, q, " "); for (i = 1; i <= n; i++) { print q[i]; m = split(kids[q[i]], k, " "); for (j = 1; j <= m; j++) q[++n] = k[j] } }'
}

# local servers of this user (databases, dev servers: anything listening on a
# port), outside Lights Out itself: agents' work may need them
servers() {
  t=" $(tree "${1:-0}" | xargs) "
  lsof -nP -iTCP -sTCP:LISTEN -u "$ME" -Fp 2>/dev/null | sed -n 's/^p//p' | sort -u | while read -r p; do
    case "$t" in *" $p "*) ;; *) echo "$p" ;; esac
  done
}

# Staying signed in: nothing is stopped; every other process of this user runs at
# the lowest background priority (efficiency cores only), except Lights Out with
# its agents and local servers.
quiet_background() {
  : > "$S/throttled"
  keep=" $(tree "${1:-0}" | xargs) $(servers "${1:-0}" | xargs) "
  ps -U "$ME" -o pid=,comm= | while read -r pid comm; do
    case "$keep" in *" $pid "*) continue ;; esac
    case "$comm" in *loginwindow*|*WindowServer*) continue ;; esac
    taskpolicy -b -p "$pid" 2>/dev/null && echo "$pid" >> "$S/throttled"
  done
}

wake_background() {
  [ -f "$S/throttled" ] && while read -r pid; do taskpolicy -B -p "$pid" 2>/dev/null; done < "$S/throttled"
  rm -f "$S/throttled"
}

case "${1:-}" in
  out)
    [ -f "$S/active" ] && exit 0
    remember lowpowermode "$(pm lowpowermode)"
    remember sleepdisabled "$(pm SleepDisabled)"
    remember spotlight "$(mdutil -s / 2>/dev/null | grep -q 'enabled' && echo on || echo off)"
    remember timemachine "$(defaults read /Library/Preferences/com.apple.TimeMachine AutoBackup 2>/dev/null || echo 0)"
    remember bluetooth "$(bt -p 2>/dev/null || echo)"
    pmset -a lowpowermode 1 2>/dev/null
    pmset -a disablesleep 1
    mdutil -a -i off >/dev/null 2>&1
    tmutil disable 2>/dev/null
    bt -p 0 2>/dev/null
    touch "$S/active"
    # log out only when nothing your agents may need would end with it
    if [ -f "$AGENTS" ] && [ "${3:-}" != stay ] && [ -n "${2:-}" ] && [ -z "$(servers "$2")" ]; then
      nohup /usr/local/lib/lightsout/logout-later "$2" "$UID_ME" "$ME" "$AGENTS" >/dev/null 2>&1 &
      echo logout
    else
      quiet_background "${2:-}"
      echo stay
    fi
    ;;
  in)
    [ -f "$S/active" ] || exit 0
    launchctl kill TERM system/sh.lightsout.agents 2>/dev/null
    v=$(cat "$S/lowpowermode" 2>/dev/null); [ -n "$v" ] && pmset -a lowpowermode "$v" 2>/dev/null
    v=$(cat "$S/sleepdisabled" 2>/dev/null); [ -f "$S/awake" ] || { [ -n "$v" ] && pmset -a disablesleep "$v"; }
    [ "$(cat "$S/spotlight" 2>/dev/null)" = on ] && mdutil -a -i on >/dev/null 2>&1
    [ "$(cat "$S/timemachine" 2>/dev/null)" = 1 ] && tmutil enable 2>/dev/null
    v=$(cat "$S/bluetooth" 2>/dev/null); [ -n "$v" ] && bt -p "$v" 2>/dev/null
    wake_background
    rm -f "$S/active" "$S/lowpowermode" "$S/spotlight" "$S/timemachine" "$S/bluetooth"
    [ -f "$S/awake" ] || rm -f "$S/sleepdisabled"
    ;;
  awake)
    remember sleepdisabled "$(pm SleepDisabled)"
    pmset -a disablesleep 1
    touch "$S/awake"
    ;;
  sleep)
    rm -f "$S/awake"
    [ -f "$S/active" ] && exit 0
    v=$(cat "$S/sleepdisabled" 2>/dev/null); [ -n "$v" ] && pmset -a disablesleep "$v"
    rm -f "$S/sleepdisabled"
    ;;
  *) echo "usage: switch out PID|in|awake|sleep" >&2; exit 2 ;;
esac
exit 0
